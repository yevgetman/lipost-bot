# ── _cron: the launchd entry point ─────────────────────────────────────────

def cmd_cron(args: argparse.Namespace) -> None:
    _do_post_run(force=False)


def _next_approved_draft() -> dict | None:
    """Oldest approved draft (by approved_at, falling back to created_at)."""
    approved = list_drafts(status="approved")
    if not approved:
        return None
    approved.sort(key=lambda d: d["meta"].get("approved_at") or d["meta"].get("created_at") or "")
    return approved[0]


def _do_post_run(force: bool) -> None:
    """Pop the oldest approved draft and publish it via lipost. No Claude here."""
    cfg = get_config()
    state = get_state()

    if not force and not cfg.get("active", False):
        log("inactive (config.active=false) — skipping run. Activate with: lipost-bot config active true")
        return

    if not force and state.get("paused"):
        log("paused — skipping run")
        return

    last = parse_iso(state.get("last_run_at"))
    if not force and last is not None:
        gap_h = hours_since(last)
        if gap_h is not None and gap_h < cfg["min_hours_between_runs"]:
            log(f"only {gap_h:.1f}h since last run (min {cfg['min_hours_between_runs']}h) — skipping")
            return

    ok, problems = check_dependencies()
    if not ok:
        for p in problems:
            log(f"dependency check failed: {p}")
        log("skipping run (run `lipost-bot status` for details)")
        return

    draft = _next_approved_draft()
    if draft is None:
        counts = count_drafts_by_status()
        log(f"no approved drafts in queue (pending={counts['pending_approval']}, approved=0) "
            f"— skipping run. Generate with: lipost-bot generate; review with: lipost-bot review")
        return

    if not force:
        jitter = random.randint(0, cfg["jitter_max_secs"])
        log(f"fired; sleeping {jitter}s (~{jitter//3600}h {(jitter%3600)//60}m); will post draft {draft['slug']}")
        time.sleep(jitter)

    # Mark last_run_at *before* invoking lipost — prevents double-fire on crash
    state["last_run_at"] = now_iso()
    save_json(STATE_FILE, state)

    # Re-read draft after the sleep — user may have changed status during the window
    draft_dir = DRAFTS_DIR / draft["slug"]
    if not (draft_dir / "meta.json").exists():
        log(f"draft {draft['slug']} disappeared during jitter — skipping")
        return
    meta = json.loads((draft_dir / "meta.json").read_text())
    if meta.get("status") != "approved":
        log(f"draft {draft['slug']} is no longer approved (status={meta.get('status')}) — skipping")
        return

    image_path = draft_dir / meta["image_filename"]
    caption = meta.get("caption") or ""
    alt = meta.get("alt_text") or ""

    lipost_path = shutil.which("lipost", path=CRON_PATH) or "lipost"
    cmd = [lipost_path, "post", "--image", str(image_path)]
    if alt:
        cmd.extend(["--alt", alt])
    cmd.append(caption)

    log(f"posting draft {draft['slug']} via lipost ({lipost_path})")
    env = {**os.environ, "PATH": CRON_PATH}
    try:
        proc = subprocess.run(cmd, env=env, capture_output=True, text=True, timeout=5 * 60)
    except subprocess.TimeoutExpired as e:
        log(f"lipost timed out after 5m; partial output: {(e.stdout or '')[-500:]}")
        return

    with LOG_FILE.open("a") as f:
        if proc.stdout:
            f.write(proc.stdout)
            if not proc.stdout.endswith("\n"):
                f.write("\n")
        if proc.stderr:
            f.write("[stderr] " + proc.stderr.replace("\n", "\n[stderr] ") + "\n")

    log(f"lipost exited rc={proc.returncode}")

    if proc.returncode != 0:
        log(f"lipost post failed; draft {draft['slug']} stays approved for retry on next run")
        return

    m = URN_RE.search(proc.stdout or "")
    if not m:
        log(f"no URN found in lipost output; draft {draft['slug']} stays approved for retry")
        return

    urn = m.group(1)
    update_draft(draft["slug"], status="posted", posted_at=now_iso(), urn=urn)
    log(f"posted {urn} (draft {draft['slug']})")

    entry = {
        "urn": urn,
        "posted_at": now_iso(),
        "exit_code": proc.returncode,
        "draft_slug": draft["slug"],
        "source_image": meta.get("source_filename"),
    }
    POSTS_FILE.parent.mkdir(parents=True, exist_ok=True)
    with POSTS_FILE.open("a") as f:
        f.write(json.dumps(entry) + "\n")


# ── arg parsing ────────────────────────────────────────────────────────────

def main() -> None:
    p = argparse.ArgumentParser(prog="lipost-bot", description="Manage the autonomous LinkedIn poster.")
    sub = p.add_subparsers(dest="cmd", required=True)

    p_init = sub.add_parser("init", help="interactive setup: write config, symlink binary, install + load launchd job")
    p_init.add_argument("--force", action="store_true", help="skip the lipost dependency check")
    p_init.set_defaults(func=cmd_init)

    p_cfg = sub.add_parser("config", help="show or update settings (active, baseline_hour, jitter_max_secs, min_hours_between_runs, permission_mode, claude_model)")
    p_cfg.add_argument("key", nargs="?")
    p_cfg.add_argument("value", nargs="?")
    p_cfg.set_defaults(func=cmd_config)

    sub.add_parser("status", help="one-screen overview: active, deps, launchd, paused, last run, next window, posts last 7d, drafts queue, images pending").set_defaults(func=cmd_status)
    sub.add_parser("pause", help="skip runs without unloading launchd").set_defaults(func=cmd_pause)
    sub.add_parser("resume", help="undo pause").set_defaults(func=cmd_resume)
    sub.add_parser("start", help="load the launchd job").set_defaults(func=cmd_start)
    sub.add_parser("stop", help="unload the launchd job").set_defaults(func=cmd_stop)
    sub.add_parser("generate", help="drain images/pending/ — Claude writes a caption per image, saves drafts as pending_approval").set_defaults(func=cmd_generate)
    sub.add_parser("review", help="walk drafts pending approval; opens each image in Preview, prompts to approve/reject/edit").set_defaults(func=cmd_review)
    p_drafts = sub.add_parser("drafts", help="list drafts grouped by status")
    p_drafts.add_argument("--status", help=f"filter to one of: {', '.join(sorted(VALID_STATUSES))}")
    p_drafts.add_argument("--limit", type=int, default=10, help="max items per status (default 10)")
    p_drafts.set_defaults(func=cmd_drafts)

    p_run = sub.add_parser("run", help="post the next approved draft now (no jitter, ignores active/paused/gap)")
    p_run.add_argument("--no-fire", action="store_true",
                       help="show the resolved plan (queue counts, next draft, lipost path, deps) without calling lipost")
    p_run.set_defaults(func=cmd_run)
    sub.add_parser("next", help="print the next scheduled window").set_defaults(func=cmd_next)
    sub.add_parser("prompt", help=f"open {PROMPT_FILE.name} in $EDITOR").set_defaults(func=cmd_prompt)

    p_posts = sub.add_parser("posts", help="list past posts")
    p_posts.add_argument("--limit", type=int, default=20)
    p_posts.add_argument("--open", action="store_true", help="open the most recent post in browser")
    p_posts.set_defaults(func=cmd_posts)

    p_logs = sub.add_parser("logs", help="show recent log lines")
    p_logs.add_argument("-f", "--follow", action="store_true")
    p_logs.add_argument("-n", "--lines", type=int, default=50)
    p_logs.set_defaults(func=cmd_logs)

    p_images = sub.add_parser("images", help=f"list pending and used images under {IMAGES_DIR}")
    p_images.add_argument("--open", action="store_true", help="open the pending dir in Finder (combine with --skipped to open the skipped dir)")
    p_images.add_argument("--skipped", action="store_true", help="with --open, open images/skipped/ instead")
    p_images.set_defaults(func=cmd_images)
    sub.add_parser("uninstall", help="remove launchd job + PATH symlink (keeps config + history)").set_defaults(func=cmd_uninstall)

    p_cron = sub.add_parser("_cron", help=argparse.SUPPRESS)
    p_cron.set_defaults(func=cmd_cron)

    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
