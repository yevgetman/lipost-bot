#!/usr/bin/env python3
"""lipost-bot — manages a launchd-driven autonomous LinkedIn poster.

Single file, stdlib only. Run `lipost-bot init` first.
"""
from __future__ import annotations

import argparse
import json
import os
import random
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path

HOME = Path.home()
REPO_DIR = Path(__file__).resolve().parent
CONFIG_DIR = HOME / ".config" / "lipost-bot"
CONFIG_FILE = CONFIG_DIR / "config.json"
STATE_FILE = CONFIG_DIR / "state.json"
POSTS_FILE = CONFIG_DIR / "posts.jsonl"
LOG_FILE = HOME / "Library" / "Logs" / "lipost-bot.log"
PROMPT_FILE = REPO_DIR / "prompt.md"
LABEL = "local.lipost-bot"
PLIST_SRC = REPO_DIR / f"{LABEL}.plist"
PLIST_DEST = HOME / "Library" / "LaunchAgents" / f"{LABEL}.plist"
BIN_LINK = HOME / ".local" / "bin" / "lipost-bot"

# Image staging — the user drops files into pending/. `lipost-bot generate`
# drains pending/ by invoking Claude to write a caption per image, then
# stores each (image + caption + alt) under drafts/<slug>/ as a draft
# awaiting human approval. Skipped images get parked under skipped/.
IMAGES_DIR = REPO_DIR / "images"
IMAGES_PENDING = IMAGES_DIR / "pending"
IMAGES_SKIPPED = IMAGES_DIR / "skipped"
IMAGE_EXTS = {".jpg", ".jpeg", ".png", ".gif"}
IMAGE_PLACEHOLDER = "{{IMAGE_PATH}}"

# Drafts directory — one subdirectory per draft, holding the image plus
# meta.json describing status (pending_approval | approved | rejected | posted).
DRAFTS_DIR = REPO_DIR / "drafts"
VALID_STATUSES = {"pending_approval", "approved", "rejected", "posted"}

# Runtime dependency: lipost CLI (https://github.com/yevgetman/lipost)
LIPOST_CONFIG = HOME / ".config" / "linkedin-cli" / "config.json"
LIPOST_TOKEN = HOME / ".config" / "linkedin-cli" / "token.json"

DEFAULT_CONFIG = {
    "active": False,                 # master arm switch; init writes False, user flips manually
    "baseline_hour": 9,
    "jitter_max_secs": 43200,        # 12h → run window 09:00–21:00
    "min_hours_between_runs": 20,
    "permission_mode": "bypassPermissions",
    "claude_model": "claude-opus-4-7",
}

# PATH for subprocesses launched by _cron (launchd env is minimal).
CRON_PATH = ":".join([
    str(HOME / ".local" / "bin"),
    str(HOME / ".bun" / "bin"),
    "/opt/homebrew/bin",
    "/usr/local/bin",
    "/usr/bin",
    "/bin",
])

URN_RE = re.compile(r"posted:\s+(urn:li:\S+)")


# ── tiny helpers ───────────────────────────────────────────────────────────

def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def load_json(path: Path, default: dict) -> dict:
    if not path.exists():
        return dict(default)
    try:
        return json.loads(path.read_text())
    except json.JSONDecodeError:
        return dict(default)


def save_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n")
    os.chmod(path, 0o600)


def get_config() -> dict:
    return {**DEFAULT_CONFIG, **load_json(CONFIG_FILE, {})}


def get_state() -> dict:
    return load_json(STATE_FILE, {"last_run_at": None, "paused": False})


def log(msg: str) -> None:
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    line = f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] {msg}\n"
    with LOG_FILE.open("a") as f:
        f.write(line)


def list_pending_images() -> list[Path]:
    if not IMAGES_PENDING.exists():
        return []
    return sorted(p for p in IMAGES_PENDING.iterdir()
                  if p.is_file() and p.suffix.lower() in IMAGE_EXTS)


# ── draft data layer ───────────────────────────────────────────────────────

def make_slug() -> str:
    ts = datetime.now().strftime("%Y%m%dT%H%M%S")
    rand = "".join(random.choices("abcdefghijklmnopqrstuvwxyz0123456789", k=6))
    return f"{ts}_{rand}"


def list_drafts(status: str | None = None) -> list[dict]:
    """Return list of {slug, dir, image_path, meta} dicts. status filters if set."""
    if not DRAFTS_DIR.exists():
        return []
    out = []
    for sub in sorted(DRAFTS_DIR.iterdir()):
        if not sub.is_dir():
            continue
        meta_path = sub / "meta.json"
        if not meta_path.exists():
            continue
        try:
            meta = json.loads(meta_path.read_text())
        except json.JSONDecodeError:
            continue
        if status and meta.get("status") != status:
            continue
        img_filename = meta.get("image_filename")
        image_path = sub / img_filename if img_filename else None
        out.append({"slug": sub.name, "dir": sub, "image_path": image_path, "meta": meta})
    return out


def count_drafts_by_status() -> dict:
    counts = {s: 0 for s in VALID_STATUSES}
    for d in list_drafts():
        s = d["meta"].get("status", "pending_approval")
        counts[s] = counts.get(s, 0) + 1
    return counts


def create_draft(image_src: Path, caption: str, alt_text: str, model: str) -> str:
    """Move image into a new draft dir under DRAFTS_DIR. Returns slug."""
    slug = make_slug()
    draft_dir = DRAFTS_DIR / slug
    draft_dir.mkdir(parents=True, exist_ok=False)

    image_filename = f"image{image_src.suffix.lower()}"
    image_dst = draft_dir / image_filename
    image_src.rename(image_dst)

    meta = {
        "slug": slug,
        "status": "pending_approval",
        "caption": caption.strip(),
        "alt_text": (alt_text or "").strip(),
        "image_filename": image_filename,
        "source_filename": image_src.name,
        "created_at": now_iso(),
        "approved_at": None,
        "rejected_at": None,
        "posted_at": None,
        "urn": None,
        "model": model,
    }
    (draft_dir / "meta.json").write_text(json.dumps(meta, indent=2) + "\n")
    return slug


def update_draft(slug: str, **changes) -> None:
    meta_path = DRAFTS_DIR / slug / "meta.json"
    meta = json.loads(meta_path.read_text())
    meta.update(changes)
    meta_path.write_text(json.dumps(meta, indent=2) + "\n")


def park_skipped_image(img: Path, reason: str) -> Path:
    """Move an image Claude said SKIP on into images/skipped/ with a reason sidecar."""
    IMAGES_SKIPPED.mkdir(parents=True, exist_ok=True)
    dest = IMAGES_SKIPPED / img.name
    if dest.exists():
        # avoid clobber
        stem, suffix = dest.stem, dest.suffix
        dest = IMAGES_SKIPPED / f"{stem}_{make_slug()[:8]}{suffix}"
    img.rename(dest)
    (dest.with_suffix(dest.suffix + ".reason.txt")).write_text(f"{now_iso()}\n{reason}\n")
    return dest


# Tolerant JSON extractor — Claude sometimes prepends/wraps the object.
_JSON_OBJ_RE = re.compile(r"\{[^{}]*\}", re.DOTALL)


def parse_claude_json(stdout: str) -> dict | None:
    s = (stdout or "").strip()
    if not s:
        return None
    # Try whole-string parse first
    try:
        obj = json.loads(s)
        if isinstance(obj, dict):
            return obj
    except json.JSONDecodeError:
        pass
    # Fall back to last {...} block that contains caption or skip
    matches = _JSON_OBJ_RE.findall(s)
    for m in reversed(matches):
        try:
            obj = json.loads(m)
            if isinstance(obj, dict) and ("caption" in obj or "skip" in obj):
                return obj
        except json.JSONDecodeError:
            continue
    return None


def check_dependencies() -> tuple[bool, list[str]]:
    """Verify all runtime dependencies. Returns (ok, list_of_problems)."""
    problems: list[str] = []
    if shutil.which("claude", path=CRON_PATH) is None:
        problems.append(
            "`claude` (Claude Code CLI) not found on PATH. Install from "
            "https://docs.claude.com/en/docs/claude-code"
        )
    if shutil.which("lipost", path=CRON_PATH) is None:
        problems.append(
            "`lipost` not found on PATH. Install from https://github.com/yevgetman/lipost "
            "(`./lipost init` symlinks it onto your PATH)."
        )
    if not LIPOST_CONFIG.exists():
        problems.append(f"missing {LIPOST_CONFIG} — run `lipost init` to write LinkedIn credentials.")
    if not LIPOST_TOKEN.exists():
        problems.append(f"missing {LIPOST_TOKEN} — run `lipost auth` to OAuth into LinkedIn.")
    return (not problems, problems)


def launchctl_loaded() -> bool:
    r = subprocess.run(["launchctl", "list"], capture_output=True, text=True)
    return any(line.split("\t")[-1] == LABEL for line in r.stdout.splitlines())


def parse_iso(s: str | None) -> datetime | None:
    if not s:
        return None
    try:
        return datetime.fromisoformat(s)
    except ValueError:
        return None


def hours_since(dt: datetime | None) -> float | None:
    if dt is None:
        return None
    return (datetime.now(timezone.utc) - dt).total_seconds() / 3600


def fmt_local(dt: datetime) -> str:
    return dt.astimezone().strftime("%Y-%m-%d %H:%M %Z")


# ── subcommands ────────────────────────────────────────────────────────────

def cmd_init(args: argparse.Namespace) -> None:
    ok, problems = check_dependencies()
    if not ok:
        print("lipost-bot has unmet dependencies:\n", file=sys.stderr)
        for p in problems:
            print(f"  - {p}", file=sys.stderr)
        print("\nFix these and re-run `lipost-bot init`. (Pass --force to skip this check.)", file=sys.stderr)
        if not getattr(args, "force", False):
            sys.exit(1)
        print("(--force given; continuing anyway.)\n", file=sys.stderr)

    cfg = get_config()
    print("lipost-bot init — press enter to keep current/default values.\n")

    def ask(prompt: str, current, cast=str):
        s = input(f"{prompt} [{current}]: ").strip()
        return cast(s) if s else current

    cfg["baseline_hour"] = ask("Baseline hour (0–23, when launchd fires before jitter)", cfg["baseline_hour"], int)
    jitter_h = ask("Jitter window in hours (max delay after baseline)", cfg["jitter_max_secs"] // 3600, int)
    cfg["jitter_max_secs"] = jitter_h * 3600
    cfg["min_hours_between_runs"] = ask("Minimum hours between runs", cfg["min_hours_between_runs"], int)
    cfg["permission_mode"] = ask("Claude permission mode", cfg["permission_mode"])

    # Always start inert. The user must explicitly arm the bot after reviewing
    # their prompt and staged images. Not promptable on purpose.
    cfg["active"] = False

    save_json(CONFIG_FILE, cfg)
    print(f"\nWrote {CONFIG_FILE}")
    print("\nactive=false (bot is inert). When ready, arm with:")
    print("    lipost-bot config active true")

    # Create the staging directories so they're discoverable.
    IMAGES_PENDING.mkdir(parents=True, exist_ok=True)
    IMAGES_SKIPPED.mkdir(parents=True, exist_ok=True)
    DRAFTS_DIR.mkdir(parents=True, exist_ok=True)
    (IMAGES_PENDING / ".gitkeep").touch()
    print(f"Drop images into {IMAGES_PENDING}/ — `lipost-bot generate` will drain them into drafts.")

    # Seed prompt.md from the shipped example so first-run users have a working
    # template to edit (with the TEMPLATE marker still in place — bot stays inert).
    example_path = REPO_DIR / "prompt.example.md"
    if example_path.exists() and not PROMPT_FILE.exists():
        PROMPT_FILE.write_text(example_path.read_text())
        print(f"Seeded {PROMPT_FILE} from prompt.example.md (template marker on line 1; remove it before going live).")

    # symlink binary onto PATH
    BIN_LINK.parent.mkdir(parents=True, exist_ok=True)
    if BIN_LINK.is_symlink() or BIN_LINK.exists():
        BIN_LINK.unlink()
    BIN_LINK.symlink_to(Path(__file__).resolve())
    print(f"Symlinked {BIN_LINK} → {Path(__file__).resolve()}")

    # write/refresh plist with current baseline_hour and load it
    write_plist(cfg)
    PLIST_DEST.parent.mkdir(parents=True, exist_ok=True)
    if PLIST_DEST.is_symlink() or PLIST_DEST.exists():
        PLIST_DEST.unlink()
    PLIST_DEST.symlink_to(PLIST_SRC)

    subprocess.run(["launchctl", "unload", str(PLIST_DEST)], capture_output=True)
    r = subprocess.run(["launchctl", "load", "-w", str(PLIST_DEST)], capture_output=True, text=True)
    if r.returncode != 0:
        print(f"launchctl load failed: {r.stderr}", file=sys.stderr)
    else:
        print(f"Loaded launchd job {LABEL} (baseline {cfg['baseline_hour']:02d}:00, jitter ≤ {jitter_h}h)")

    pstate = _prompt_state()
    if pstate == "missing":
        print(f"\nReminder: {PROMPT_FILE} is missing — `lipost-bot generate` will refuse to run until it exists.")
    elif pstate == "empty":
        print(f"\nReminder: {PROMPT_FILE} is empty — `lipost-bot generate` will refuse to run until you fill it.")
    elif pstate == "template":
        print(f"\nReminder: {PROMPT_FILE} still has the TEMPLATE marker — `lipost-bot generate` will refuse to run until you remove line 1.")


def write_plist(cfg: dict) -> None:
    """Regenerate the plist from config (so baseline_hour edits propagate)."""
    program = str((REPO_DIR / "lipost-bot").resolve())
    plist = f'''<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{LABEL}</string>
    <key>ProgramArguments</key>
    <array>
        <string>{program}</string>
        <string>_cron</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>{int(cfg["baseline_hour"])}</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>{LOG_FILE}</string>
    <key>StandardErrorPath</key>
    <string>{LOG_FILE}</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
'''
    PLIST_SRC.write_text(plist)


def cmd_config(args: argparse.Namespace) -> None:
    cfg = get_config()
    if not args.key:
        for k, v in cfg.items():
            print(f"{k} = {v}")
        return

    if args.key not in DEFAULT_CONFIG:
        print(f"unknown key: {args.key}", file=sys.stderr)
        print(f"valid keys: {', '.join(DEFAULT_CONFIG)}", file=sys.stderr)
        sys.exit(1)

    if args.value is None:
        print(f"{args.key} = {cfg[args.key]}")
        return

    # cast value to type of default (booleans need special handling — bool("false") is True)
    target_type = type(DEFAULT_CONFIG[args.key])
    if target_type is bool:
        v = args.value.strip().lower()
        if v in ("true", "1", "yes", "on"):
            new_val = True
        elif v in ("false", "0", "no", "off"):
            new_val = False
        else:
            print(f"invalid value for {args.key}: expected true/false", file=sys.stderr)
            sys.exit(1)
    else:
        try:
            new_val = target_type(args.value)
        except ValueError:
            print(f"invalid value for {args.key}: expected {target_type.__name__}", file=sys.stderr)
            sys.exit(1)

    if args.key == "baseline_hour" and not (0 <= new_val <= 23):
        print("baseline_hour must be 0–23", file=sys.stderr)
        sys.exit(1)
    if args.key == "jitter_max_secs" and new_val < 0:
        print("jitter_max_secs must be ≥ 0", file=sys.stderr)
        sys.exit(1)

    cfg[args.key] = new_val
    save_json(CONFIG_FILE, cfg)
    print(f"set {args.key} = {new_val}")

    if args.key == "baseline_hour":
        write_plist(cfg)
        if launchctl_loaded():
            subprocess.run(["launchctl", "unload", str(PLIST_DEST)], capture_output=True)
            subprocess.run(["launchctl", "load", "-w", str(PLIST_DEST)], capture_output=True)
            print(f"reloaded launchd job (new baseline {new_val:02d}:00)")


def cmd_status(args: argparse.Namespace) -> None:
    cfg = get_config()
    state = get_state()
    loaded = launchctl_loaded()

    last = parse_iso(state.get("last_run_at"))
    last_str = fmt_local(last) if last else "never"
    last_ago = hours_since(last)
    last_ago_str = f" ({last_ago:.1f}h ago)" if last_ago is not None else ""

    posts_7d = count_posts_since(datetime.now(timezone.utc) - timedelta(days=7))
    deps_ok, deps_problems = check_dependencies()

    active = cfg.get("active", False)
    print(f"  active:     {active}{'' if active else '  ← inert; activate with: lipost-bot config active true'}")
    print(f"  deps:       {'OK' if deps_ok else 'BROKEN — see problems below'}")
    print(f"  launchd:    {'loaded' if loaded else 'NOT loaded (run: lipost-bot start)'}")
    print(f"  paused:     {state.get('paused', False)}")
    print(f"  last run:   {last_str}{last_ago_str}")
    print(f"  posts (7d): {posts_7d}")
    print(f"  next:       {next_window_str(cfg, last)}")
    prompt_state = _prompt_state()
    prompt_label = {
        "missing":  "missing (will skip)",
        "empty":    "empty (will skip)",
        "template": "template — edit before going live (will skip)",
        "ready":    "ready",
    }[prompt_state]
    print(f"  prompt:     {prompt_label}  (used by `generate`, not at fire time)")

    counts = count_drafts_by_status()
    queue_status = (
        f"approved={counts['approved']}, pending={counts['pending_approval']}, "
        f"rejected={counts['rejected']}, posted={counts['posted']}"
    )
    print(f"  drafts:     {queue_status}")
    if counts["approved"] == 0 and active:
        print(f"              ← no approved drafts; next fire will skip. "
              f"Run: lipost-bot generate, then review.")

    print(f"  images:     {len(list_pending_images())} pending in {IMAGES_PENDING} (run `generate` to consume)")
    print(f"  config:     baseline_hour={cfg['baseline_hour']}, jitter≤{cfg['jitter_max_secs']//3600}h, "
          f"min_gap={cfg['min_hours_between_runs']}h, mode={cfg['permission_mode']}, model={cfg['claude_model']}")

    if not deps_ok:
        print("\n  dependency problems:")
        for p in deps_problems:
            print(f"    - {p}")


# If this marker is present in prompt.md, the bot treats the prompt as
# "not customized yet" and skips runs until you remove it.
TEMPLATE_MARKER = "<!-- TEMPLATE: lipost-bot will refuse to run while this line is present"


def _prompt_state() -> str:
    """One of: 'missing', 'empty', 'template', 'ready'."""
    if not PROMPT_FILE.exists():
        return "missing"
    text = PROMPT_FILE.read_text().strip()
    if not text:
        return "empty"
    if TEMPLATE_MARKER in text:
        return "template"
    return "ready"


def _prompt_has_content() -> bool:
    return _prompt_state() == "ready"


def next_window_str(cfg: dict, last: datetime | None) -> str:
    now = datetime.now().astimezone()
    today_baseline = now.replace(hour=cfg["baseline_hour"], minute=0, second=0, microsecond=0)
    jitter_h = cfg["jitter_max_secs"] / 3600

    # if today's window already passed (end < now) or we already ran today after baseline → tomorrow
    today_end = today_baseline + timedelta(seconds=cfg["jitter_max_secs"])
    if now > today_end or (last and last >= today_baseline.astimezone(timezone.utc)):
        base = today_baseline + timedelta(days=1)
    else:
        base = today_baseline

    end = base + timedelta(seconds=cfg["jitter_max_secs"])
    return f"{base.strftime('%Y-%m-%d %H:%M')} – {end.strftime('%H:%M')} (window {jitter_h:g}h)"


def count_posts_since(cutoff: datetime) -> int:
    if not POSTS_FILE.exists():
        return 0
    n = 0
    for line in POSTS_FILE.read_text().splitlines():
        try:
            entry = json.loads(line)
            t = parse_iso(entry.get("posted_at"))
            if t and t >= cutoff:
                n += 1
        except json.JSONDecodeError:
            continue
    return n


def cmd_pause(args: argparse.Namespace) -> None:
    state = get_state()
    state["paused"] = True
    save_json(STATE_FILE, state)
    print("paused. resume with: lipost-bot resume")


def cmd_resume(args: argparse.Namespace) -> None:
    state = get_state()
    state["paused"] = False
    save_json(STATE_FILE, state)
    print("resumed.")


def cmd_start(args: argparse.Namespace) -> None:
    if launchctl_loaded():
        print("already loaded.")
        return
    r = subprocess.run(["launchctl", "load", "-w", str(PLIST_DEST)], capture_output=True, text=True)
    if r.returncode != 0:
        print(f"failed: {r.stderr}", file=sys.stderr)
        sys.exit(1)
    print(f"loaded {LABEL}")


def cmd_stop(args: argparse.Namespace) -> None:
    if not launchctl_loaded():
        print("not loaded.")
        return
    subprocess.run(["launchctl", "unload", str(PLIST_DEST)], capture_output=True)
    print(f"unloaded {LABEL}")


def cmd_run(args: argparse.Namespace) -> None:
    """Fire immediately: no jitter, ignore active/pause/min-gap guards."""
    if args.no_fire:
        _print_dry_plan()
        return
    print("running now (no jitter, ignoring active/pause/gap guards)...")
    _do_post_run(force=True)


def _print_dry_plan() -> None:
    """Print what `lipost-bot run` would do, without calling lipost."""
    cfg = get_config()
    state = get_state()
    deps_ok, deps_problems = check_dependencies()
    lipost_path = shutil.which("lipost", path=CRON_PATH) or "<not found on CRON_PATH>"

    last = parse_iso(state.get("last_run_at"))
    gap_h = hours_since(last)
    next_draft = _next_approved_draft()
    counts = count_drafts_by_status()

    print("=== lipost-bot run --no-fire ===\n")
    print(f"would skip due to: ", end="")
    reasons = []
    if not cfg.get("active", False):
        reasons.append("inactive (config.active=false)")
    if state.get("paused"):
        reasons.append("paused")
    if gap_h is not None and gap_h < cfg["min_hours_between_runs"]:
        reasons.append(f"min-gap ({gap_h:.1f}h < {cfg['min_hours_between_runs']}h)")
    if next_draft is None:
        reasons.append("no approved drafts in queue")
    if not deps_ok:
        reasons.append("dependency check")
    print(", ".join(reasons) if reasons else "(nothing — would post)")
    if reasons:
        print("  note: `run` ignores `active`, `paused`, and the min-gap guard at runtime; `_cron` (launchd) honors all three. The queue-empty case is honored by both.")
    print()

    print(f"queue:         approved={counts['approved']}, pending={counts['pending_approval']}, "
          f"rejected={counts['rejected']}, posted={counts['posted']}")
    if next_draft is not None:
        meta = next_draft["meta"]
        cap = (meta.get("caption") or "").replace("\n", " ")
        cap_preview = cap[:120] + ("…" if len(cap) > 120 else "")
        print(f"next draft:    {next_draft['slug']}")
        print(f"  approved at: {meta.get('approved_at') or '?'}")
        print(f"  image:       {next_draft['image_path']}")
        print(f"  alt:         {meta.get('alt_text', '')}")
        print(f"  caption:     {cap_preview}")
    print()

    print(f"cwd:           {REPO_DIR}")
    print(f"lipost path:   {lipost_path}")
    print(f"PATH (cron):   {CRON_PATH}")
    print(f"timeout:       5 min (lipost call)")
    print()

    if next_draft is not None:
        meta = next_draft["meta"]
        cmd_preview = f'{lipost_path} post --image "{next_draft["image_path"]}"'
        if meta.get("alt_text"):
            cmd_preview += f' --alt "{meta["alt_text"]}"'
        cmd_preview += ' "<caption>"'
        print("command:")
        print(f"  {cmd_preview}")
        print()

    if deps_problems:
